// Zed settings
{
  "icon_theme": "Bearded Icon Theme",
  "terminal": {
    "font_family": "Hack",
    "copy_on_select": true,
    "keep_selection_on_copy": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Tokyo Night Storm",
    "dark": "Tokyo Night Storm"
  },
  "autosave": "on_focus_change",
  "format_on_save": "off",
  "hard_tabs": false,
  "tab_size": 2,
  "soft_wrap": "editor_width",
  "show_completions_on_input": true
}
